# Tour&Travel Deployment Environment Variables
# Copy this file to .env and configure for your environment

# -----------------
# Frontend Configuration
# -----------------
VITE_API_BASE_URL=/api/v1
VITE_APP_ENV=production

# -----------------
# Database Configuration
# -----------------
POSTGRES_DB=tourtravel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_postgres_password
DB_HOST=postgres
DB_PORT=5432
# Spring boot references these generic DB variables
DB_NAME=tourtravel
DB_USERNAME=postgres
DB_PASSWORD=secure_postgres_password

# -----------------
# Cache Configuration
# -----------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------
# Backend Security
# -----------------
# Generate a strong, Base64-encoded secret key for JWT (at least 256 bits)
JWT_SECRET=super_secret_key_that_should_be_changed_in_production_2026!@#$
